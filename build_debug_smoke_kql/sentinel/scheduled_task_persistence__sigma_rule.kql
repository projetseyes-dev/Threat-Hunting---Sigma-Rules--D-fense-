EventID == 4698 and (TaskContent contains "powershell" or TaskContent contains "PowerShell" or TaskContent contains "-enc" or TaskContent contains "-EncodedCommand" or TaskContent contains "IEX" or TaskContent contains "Invoke-Expression" or TaskContent contains "DownloadString" or TaskContent contains "%TEMP%" or TaskContent contains "%APPDATA%" or TaskContent contains "AppData" or TaskContent contains "cmd.exe") and (not(TaskName startswith "Microsoft\\"))

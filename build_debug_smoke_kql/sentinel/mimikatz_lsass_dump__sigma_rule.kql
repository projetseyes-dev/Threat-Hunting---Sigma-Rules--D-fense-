TargetImage endswith "\\lsass.exe" and (GrantedAccess in~ ("0x1010", "0x1410", "0x1438", "0x143A", "0x1FFFFF", "0x101010", "0x1F1FFF", "0x1F2FFF", "0x1F3FFF")) and ((SourceImage endswith "\\rundll32.exe" or SourceImage endswith "\\procdump.exe" or SourceImage endswith "\\taskmgr.exe") or (CallTrace contains "MiniDumpWriteDump" or CallTrace contains "comsvcs.dll")) and (not((SourceImage contains "\\Program Files\\Windows Defender\\" or SourceImage contains "\\Program Files\\CrowdStrike\\" or SourceImage contains "\\Program Files\\SentinelOne\\" or SourceImage contains "\\Program Files\\Cybereason\\" or SourceImage contains "\\Program Files\\Carbon Black\\")))
